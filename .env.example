# Database Configuration (SQLite local or PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./safety_engine.db
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis Configuration (In-memory fallback operates seamlessly when Redis is offline)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Optional Google Gemini LLM API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Security & Authorization
ADMIN_API_KEY=super-admin-secret-key-123
SECRET_KEY=antigravity-safety-engine-jwt-secret-key-32chars

# Supabase Cloud Authentication & User Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_service_key

